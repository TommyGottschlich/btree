#!/bin/bash

# Formats all source files using clang-format
# Run from anywhere as: ./support/make_beautify.sh

set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if ! command -v clang-format &>/dev/null; then
    echo "clang-format not found. Install with: brew install clang-format"
    exit 1
fi

echo "Formatting source files..."
find "$REPO_ROOT/src" "$REPO_ROOT/utests" -name "*.hpp" -o -name "*.cpp" -o -name "*.tpp" | xargs clang-format -i
echo "Done."
